#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --gpus=1
#SBATCH --cpus-per-task=8
#SBATCH --job-name=cv2_combine
#SBATCH --ntasks=1
#SBATCH --time=00:20:00
#SBATCH --mem=32000M
#SBATCH --output=outfiles/combine_sigmas_%A.out

# σ-combination experiment. Pure CPU work (combine pre-rendered σ maps from
# disk, run conformal). Uses gpu_h100 only because that's where the conda env
# is provisioned; could also run on CPU partitions if env is portable.

set -eu

OUT="${OUT:-/scratch-shared/$USER/output/train}"

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/CV2/conformal-uncertainty-3dgs

set +u
eval "$(conda shell.bash hook)"
conda activate gaussian_splatting
set -u

echo "================================================================"
echo "σ-combination ablation"
echo "Run dir: $OUT"
echo "Start:   $(date)"
echo "================================================================"

python scripts/experiment_combine_sigmas.py \
    --run_dir "$OUT" \
    --iteration 30000 \
    --alpha 0.1 \
    --seed 42

echo "End: $(date)"
