#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --gpus=1
#SBATCH --cpus-per-task=8
#SBATCH --job-name=cv2_uncertainty
#SBATCH --ntasks=1
#SBATCH --time=04:00:00
#SBATCH --mem=64000M
#SBATCH --output=outfiles/uncertainty_%A.out

# End-to-end uncertainty pipeline for one scene.
# Submit with:   SCENE=/gpfs/home4/pkarageorgis/datasets/tandt/train sbatch snellius_jobs/01_full_pipeline.job
# Optional env: OUT, ITERS, ALPHA

set -eu

if [ -z "${SCENE:-}" ]; then
    echo "ERROR: set SCENE=/path/to/scene"
    exit 1
fi

OUTPUT_BASE="${OUTPUT_BASE:-/scratch-shared/$USER/output}"
OUT="${OUT:-$OUTPUT_BASE/$(basename "$SCENE")}"
ITERS="${ITERS:-30000}"
ALPHA="${ALPHA:-0.1}"

module purge
module load 2025
module load Anaconda3/2025.06-1

module load CUDA/12.9.1
export CUDA_HOME=$CUDA_ROOT
export TORCH_CUDA_ARCH_LIST="8.0;9.0"

cd $HOME/CV2/conformal-uncertainty-3dgs

# Properly initialize conda for non-interactive bash
# Temporarily disable 'set -u' to avoid unbound variable errors in conda activation
set +u
eval "$(conda shell.bash hook)"
conda activate gaussian_splatting
set -u

SPLIT_DIR="$OUT/splits"
RUN_DIR="$OUT"
OUTPUT_ROOT="$(dirname "$OUT")"

mkdir -p "$OUT" "$SPLIT_DIR"

echo "================================================================"
echo "Scene      : $SCENE"
echo "Output     : $OUT"
echo "Iterations : $ITERS"
echo "Alpha      : $ALPHA"
echo "Host       : $(hostname)"
echo "Start      : $(date)"
echo "================================================================"

# Force rebuild of the CUDA submodules for $TORCH_CUDA_ARCH_LIST. The conda env's
# pre-built .so files are sm_80-only and silently degenerate on H100 (a small
# 3-point kernel call passes but a real ~200k-point call fails with "no kernel
# image is available"). Rebuild always on H100 — cheap insurance, ~3-4 min.
# Also: gaussian_renderer/__init__.py expects the dr_aa branch of the rasterizer
# (depth output + antialiasing flag); .gitmodules pins main, so check out dr_aa
# explicitly before building.
echo "[setup] Switching rasterizer submodule to dr_aa branch + applying top-K patch ..."
(
    cd submodules/diff-gaussian-rasterization
    git fetch origin dr_aa --quiet
    git checkout dr_aa --quiet
    git reset --hard origin/dr_aa --quiet  # discard any prior patch state for idempotence
    git apply ../../patches/0001-rasterizer-topk-weights.patch
)

echo "[setup] Rebuilding submodules for arches $TORCH_CUDA_ARCH_LIST ..."
pip uninstall -y diff_gaussian_rasterization simple_knn fused_ssim || true
rm -rf submodules/diff-gaussian-rasterization/build \
       submodules/diff-gaussian-rasterization/diff_gaussian_rasterization.egg-info \
       submodules/simple-knn/build submodules/simple-knn/simple_knn.egg-info \
       submodules/fused-ssim/build submodules/fused-ssim/fused_ssim.egg-info
pip install --no-build-isolation submodules/diff-gaussian-rasterization
pip install --no-build-isolation submodules/simple-knn
pip install --no-build-isolation submodules/fused-ssim

# Verify with a realistic-size kernel call (the 3-point edge case is not enough).
python -c "
import torch
from simple_knn._C import distCUDA2
x = torch.randn(10000, 3, device='cuda')
y = distCUDA2(x); torch.cuda.synchronize()
print(f'simple_knn kernel OK (10k points, mean dist {y.mean().item():.4f})')
"

# 1. Round-robin train/calib/test split (idempotent — re-writes manifests)
echo "[1/9] Preparing split manifests"
python scripts/prepare_round_robin_split.py \
    --source_path "$SCENE" \
    --images images \
    --output_dir "$SPLIT_DIR"

# 2. Skip training — reuse cached model under $OUT.
PLY_PATH="$OUT/point_cloud/iteration_$ITERS/point_cloud.ply"
if [ ! -f "$PLY_PATH" ]; then
    echo "ERROR: expected cached trained model at $PLY_PATH (use 01_full_pipeline_h100.job to train)."
    exit 1
fi
echo "[2/9] Reusing cached 3DGS model at $PLY_PATH"

# 3. Render color/depth raw sigma artifacts
echo "[3/9] Rendering color sigma"
python scripts/render_color.py -m "$OUT" --split_dir "$SPLIT_DIR" --output_root "$OUTPUT_ROOT" --skip_train

echo "[4/9] Rendering depth sigma"
python scripts/render_depth.py -m "$OUT" --split_dir "$SPLIT_DIR" --output_root "$OUTPUT_ROOT" --skip_train

# 4. Top-K entropy
echo "[5/9] Rendering entropy (top-K weights)"
python scripts/render_entropy.py -m "$OUT" --split_dir "$SPLIT_DIR" --output_root "$OUTPUT_ROOT" --skip_train --top_k 4

# 5. Fisher sensitivity (compute then render)
echo "[6/9] Computing Fisher sensitivity (PUP3DGS)"
python scripts/compute_sensitivity.py -m "$OUT"
python scripts/render_per_gaussian_scalar.py \
    -m "$OUT" --split_dir "$SPLIT_DIR" --output_root "$OUTPUT_ROOT" --skip_train \
    --modality sensitivity \
    --scores_path "$OUT/uncertainty/fishers.npz" \
    --score_key fishers_log_dets \
    --score_transform shift_positive

# 6. Visibility (compute then render)
echo "[7/9] Computing visibility (4DGS-W)"
python scripts/compute_visibility.py -m "$OUT"
python scripts/render_per_gaussian_scalar.py \
    -m "$OUT" --split_dir "$SPLIT_DIR" --output_root "$OUTPUT_ROOT" --skip_train \
    --modality visibility \
    --scores_path "$OUT/uncertainty/visibility.npz" \
    --score_key uncertainty_log

# 7. Floater likelihood (composite of isolation / visibility / opacity)
echo "[8/9] Computing floater likelihood (TIDI-GS-inspired)"
python scripts/compute_floater.py -m "$OUT"
python scripts/render_per_gaussian_scalar.py \
    -m "$OUT" --split_dir "$SPLIT_DIR" --output_root "$OUTPUT_ROOT" --skip_train \
    --modality floater \
    --scores_path "$OUT/uncertainty/floater.npz" \
    --score_key score_shifted

# 8. Conformal prediction for every modality
echo "[9/9] Conformal prediction across modalities"
for MOD in color depth entropy sensitivity visibility floater; do
    echo "    -> $MOD"
    python scripts/conformal_prediction.py \
        --run_dir "$RUN_DIR" \
        --modality "$MOD" \
        --sigma_norm minmax_calib \
        --alpha "$ALPHA" \
        --calib_sample_ratio 0.1
done

# 8. Aggregate
echo "[done] Exporting active-learning rankings"
python scripts/active_learning/export_rankings.py --run_dir "$RUN_DIR" --sigma_norm minmax_calib --score_top_fraction 0.10

echo "[done] Aggregating results"
python scripts/aggregate_results.py --run_dir "$RUN_DIR"

echo "================================================================"
echo "Pipeline complete. Results: $RUN_DIR/results.md"
echo "End: $(date)"
echo "================================================================"
