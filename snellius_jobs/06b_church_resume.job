#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --gpus=1
#SBATCH --cpus-per-task=8
#SBATCH --job-name=cv2_church_resume
#SBATCH --ntasks=1
#SBATCH --time=03:00:00
#SBATCH --mem=64000M
#SBATCH --output=outfiles/church_resume_%A.out

# Resume the Church (A)/(B)/(C) experiment from after step [5/8] — assumes:
#   - trained model exists at $OUT/point_cloud/iteration_$ITERS/
#   - all 6 σ renders (color, depth, entropy, sensitivity, visibility, floater) on disk
# Just runs: v2-variant compute, conformal × 6, (A) metrics, (B) fixed-K, (C) conformal-K.

set -eu

SCENE="${SCENE:-/scratch-shared/$USER/datasets/Church_scene}"
OUTPUT_BASE="${OUTPUT_BASE:-/scratch-shared/$USER/output}"
OUT="${OUT:-$OUTPUT_BASE/Church}"
ITERS="${ITERS:-30000}"
ALPHA="${ALPHA:-0.1}"
FIXED_K="${FIXED_K:-0.10}"
export OUT ITERS ALPHA FIXED_K SCENE

module purge
module load 2025
module load Anaconda3/2025.06-1
module load CUDA/12.9.1
export CUDA_HOME=$CUDA_ROOT
export TORCH_CUDA_ARCH_LIST="8.0;9.0"

cd $HOME/CV2/conformal-uncertainty-3dgs

set +u
eval "$(conda shell.bash hook)"
conda activate gaussian_splatting
set -u

SPLIT_DIR="$OUT/splits"
RUN_DIR="$OUT"
OUTPUT_ROOT="$(dirname "$OUT")"

echo "================================================================"
echo "Church RESUME (post-render phase)"
echo "Scene  : $SCENE"
echo "Output : $OUT"
echo "Iters  : $ITERS"
echo "Alpha  : $ALPHA"
echo "FIXED_K: $FIXED_K"
echo "Start  : $(date)"
echo "================================================================"

# Sanity check the prerequisites.
PLY="$OUT/point_cloud/iteration_$ITERS/point_cloud.ply"
[ -f "$PLY" ] || { echo "ERROR: no trained model at $PLY"; exit 1; }
[ -d "$OUT/calib/ours_$ITERS/raw_sigma/color" ] || { echo "ERROR: missing color σ renders"; exit 1; }
[ -d "$OUT/calib/ours_$ITERS/raw_sigma/floater" ] || { echo "ERROR: missing floater σ renders"; exit 1; }
echo "Prerequisites OK."

# Make sure floater.npz exists too (it should, since render_per_gaussian_scalar wrote it).
[ -f "$OUT/uncertainty/floater.npz" ] || { echo "ERROR: missing $OUT/uncertainty/floater.npz"; exit 1; }

# Compute v2 variant for pruning
echo "[a/4] Computing v2_rank_mult floater score for pruning"
python - <<PY
import numpy as np
from pathlib import Path
import sys
sys.path.insert(0, "scripts")
from experiment_floater_variants import compute_variants
OUT = "$OUT"
d = np.load(f"{OUT}/uncertainty/floater.npz")
variants = compute_variants(
    np.asarray(d["spatial_isolation"], np.float32),
    np.asarray(d["visibility"], np.float32),
    np.asarray(d["opacity"], np.float32),
)
v2 = variants["v2_rank_mult"]
v2_shifted = (v2 - float(v2.min()) + 1e-6).astype(np.float32)
out = Path(f"{OUT}/uncertainty/floater_v2_for_prune.npz")
np.savez_compressed(out, score=v2, score_shifted=v2_shifted)
print(f"saved {out}")
PY

# Baseline conformal for all 6 modalities
echo "[b/4] Conformal across 6 modalities"
for MOD in color depth entropy sensitivity visibility floater; do
    echo "    -> $MOD"
    python scripts/conformal_prediction.py --run_dir "$RUN_DIR" --modality "$MOD" \
        --sigma_norm minmax_calib --alpha "$ALPHA" --calib_sample_ratio 0.1
done

# (A) baseline metrics
echo "[c/4] (A) baseline PSNR/SSIM/LPIPS"
python metrics.py -m "$OUT"

# (B) TIDI-GS-style fixed-K pruning
echo "[d/4] (B) fixed-K=${FIXED_K} prune + render + metrics"
B_OUT="$OUT/_prune_B_fixed_K${FIXED_K}"
python scripts/prune_and_render.py \
    -m "$OUT" --split_dir "$SPLIT_DIR" --iteration "$ITERS" \
    --scores_npz "$OUT/uncertainty/floater_v2_for_prune.npz" --score_key score_shifted \
    --prune_fraction "$FIXED_K" --output_dir "$B_OUT" \
    --skip_calib
python - <<PY
from pathlib import Path
import shutil
B = Path("$B_OUT")
src = Path("$OUT")
for f in ("cfg_args", "cameras.json"):
    p = src / f
    if p.exists() and not (B / f).exists():
        shutil.copy2(p, B / f)
print("copied meta files into", B)
PY
python metrics.py -m "$B_OUT"

# (C) Conformal-calibrated pruning
echo "[e/4] (C) conformal-pick-K + prune + render + metrics"
python scripts/conformal_pick_pruning_K.py \
    --model_path "$OUT" \
    --split_dir "$SPLIT_DIR" \
    --iteration "$ITERS" \
    --scores_npz "$OUT/uncertainty/floater_v2_for_prune.npz" \
    --score_key score_shifted \
    --sigma_modality color --sigma_key color_std \
    --K_grid "0.00,0.02,0.05,0.10,0.15,0.20" \
    --alpha "$ALPHA"

K_STAR=$(python -c "import json; print(json.load(open('$OUT/uncertainty/pruning_pick.json'))['K_star'])")
echo "K* selected = $K_STAR"

C_OUT="$OUT/_prune_C_Kstar_${K_STAR}"
if [ "$(echo "$K_STAR > 0" | bc -l)" -eq 1 ]; then
    python scripts/prune_and_render.py \
        -m "$OUT" --split_dir "$SPLIT_DIR" --iteration "$ITERS" \
        --scores_npz "$OUT/uncertainty/floater_v2_for_prune.npz" --score_key score_shifted \
        --prune_fraction "$K_STAR" --output_dir "$C_OUT" \
        --skip_calib
    python - <<PY
from pathlib import Path
import shutil
C = Path("$C_OUT")
src = Path("$OUT")
for f in ("cfg_args", "cameras.json"):
    p = src / f
    if p.exists() and not (C / f).exists():
        shutil.copy2(p, C / f)
print("copied meta files into", C)
PY
    python metrics.py -m "$C_OUT"
else
    echo "K* = 0 — config (C) identical to (A); skipping re-render."
fi

# Aggregate final comparison table
python - <<PY
import json
from pathlib import Path
OUT = Path("$OUT")
res = {}
for tag, path in [("A_baseline", OUT/"results.json"),
                  ("B_fixed_K",  Path("$B_OUT")/"results.json"),
                  ("C_conformal_K", Path("$C_OUT")/"results.json")]:
    if path.exists():
        d = json.load(open(path))
        method = list(d.keys())[0]
        res[tag] = d[method]
    else:
        res[tag] = None

print("=" * 78)
print("Church — TIDI-GS comparison")
print("=" * 78)
print(f"{'config':22} {'PSNR':>10} {'SSIM':>10} {'LPIPS':>10}")
for tag, m in res.items():
    if m is None:
        print(f"{tag:22} (missing)")
    else:
        print(f"{tag:22} {m.get('PSNR',float('nan')):>10.4f} {m.get('SSIM',float('nan')):>10.4f} {m.get('LPIPS',float('nan')):>10.4f}")

pp = json.load(open(OUT/"uncertainty/pruning_pick.json"))
print(f"\nK* = {pp['K_star']}, target coverage = {pp['target_coverage']}")

out_md = OUT/"tidi_comparison.md"
with open(out_md, "w") as f:
    f.write(f"# Church — TIDI-GS comparison\n\n")
    f.write(f"| config | PSNR | SSIM | LPIPS |\n|---|---|---|---|\n")
    for tag, m in res.items():
        if m is None:
            f.write(f"| {tag} | (missing) | | |\n")
        else:
            f.write(f"| {tag} | {m.get('PSNR',0):.4f} | {m.get('SSIM',0):.4f} | {m.get('LPIPS',0):.4f} |\n")
    f.write(f"\nK* = {pp['K_star']} (chosen on calib via PSNR-improvement subject to coverage >= {pp['target_coverage']}).\n")
print(f"\nWrote {out_md}")
PY

echo "================================================================"
echo "End: $(date)"
echo "================================================================"
