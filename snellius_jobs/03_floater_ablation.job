#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --gpus=1
#SBATCH --cpus-per-task=8
#SBATCH --job-name=cv2_floater_ablation
#SBATCH --ntasks=1
#SBATCH --time=00:45:00
#SBATCH --mem=64000M
#SBATCH --output=outfiles/floater_ablation_%A.out

# Floater score variant ablation. Re-uses the cached trained model + already-
# rendered color/depth/etc. artifacts under /scratch-shared/$USER/output/train/
# and just runs the 6 variants of compute_floater + render + conformal.

set -eu

OUT="${OUT:-/scratch-shared/$USER/output/train}"

module purge
module load 2025
module load Anaconda3/2025.06-1
module load CUDA/12.9.1
export CUDA_HOME=$CUDA_ROOT
export TORCH_CUDA_ARCH_LIST="8.0;9.0"

cd $HOME/CV2/conformal-uncertainty-3dgs

set +u
eval "$(conda shell.bash hook)"
conda activate gaussian_splatting
set -u

# Sanity: the conda env's submodules were already rebuilt + patched for H100 by
# the previous job, so we don't need to rebuild here. Just confirm imports work.
python -c "
import torch
from diff_gaussian_rasterization import GaussianRasterizer
from simple_knn._C import distCUDA2
print('rasterizer + simple_knn import OK')
"

echo "================================================================"
echo "Floater variant ablation"
echo "Model: $OUT"
echo "Start: $(date)"
echo "================================================================"

python scripts/experiment_floater_variants.py \
    --model_path "$OUT" \
    --run_dir "$OUT" \
    --iteration 30000 \
    --alpha 0.1 \
    --seed 42 \
    --skip_render

echo "End: $(date)"
