#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gres=gpu:1
#SBATCH --gpus=1
#SBATCH --cpus-per-task=8
#SBATCH --job-name=cv2_al
#SBATCH --ntasks=1
#SBATCH --time=24:00:00
#SBATCH --mem=64000M
#SBATCH --output=outfiles/al_%A.out

# Active-learning loop for one scene and one acquisition method.
#
# Required:
#   SCENE=/path/to/scene
#
# Optional:
#   AL_ROOT=/scratch-shared/$USER/output_fullwidth/active_learning/<scene_slug>
#   METHOD=combined          # random|uniform|fisher|pup|sensitivity|color|visibility|combined
#   SEED=0
#   ROUNDS=3                # round_00 plus this many acquisition updates
#   INIT_TRAIN=10%          # count, fraction, or percent string
#   INIT_METHOD=random      # random|random_fps|first_fps
#   CALIB=10%
#   TEST=20%
#   ADD_K=5
#   MIN_INDEX_GAP=0         # avoid selecting candidates within this sorted-image distance of train/selected views
#   INDEX_PENALTY=0.0       # optional soft score penalty by sorted-image proximity
#   ITERS=7000
#   ITERS_MODE=fixed        # fixed|popgs
#   PRESET=                # popgs10|popgs20
#   ALPHA=0.1

set -eu

if [ -z "${SCENE:-}" ]; then
    echo "ERROR: set SCENE=/path/to/scene"
    exit 1
fi

ROUNDS_WAS_SET="${ROUNDS+x}"
INIT_TRAIN_WAS_SET="${INIT_TRAIN+x}"
INIT_METHOD_WAS_SET="${INIT_METHOD+x}"
CALIB_WAS_SET="${CALIB+x}"
TEST_WAS_SET="${TEST+x}"
ADD_K_WAS_SET="${ADD_K+x}"
MIN_INDEX_GAP_WAS_SET="${MIN_INDEX_GAP+x}"
ITERS_MODE_WAS_SET="${ITERS_MODE+x}"
FINAL_ITERS_WAS_SET="${FINAL_ITERS+x}"
TEST_MODE_WAS_SET="${TEST_MODE+x}"
METHOD="${METHOD:-combined}"
SEED="${SEED:-0}"
ROUNDS="${ROUNDS:-3}"
INIT_TRAIN="${INIT_TRAIN:-10%}"
INIT_METHOD="${INIT_METHOD:-random}"
CALIB="${CALIB:-10%}"
TEST="${TEST:-20%}"
ADD_K="${ADD_K:-5}"
MIN_INDEX_GAP="${MIN_INDEX_GAP:-0}"
INDEX_PENALTY="${INDEX_PENALTY:-0.0}"
ITERS="${ITERS:-7000}"
ITERS_MODE="${ITERS_MODE:-fixed}"
PRESET="${PRESET:-}"
FINAL_ITERS="${FINAL_ITERS:-}"
TEST_MODE="${TEST_MODE:-random}"
LLFFHOLD="${LLFFHOLD:-8}"
ALPHA="${ALPHA:-0.1}"
case "$PRESET" in
    popgs10)
        if [ -z "$INIT_TRAIN_WAS_SET" ]; then INIT_TRAIN="2"; fi
        if [ -z "$INIT_METHOD_WAS_SET" ]; then INIT_METHOD="random_fps"; fi
        if [ -z "$CALIB_WAS_SET" ]; then CALIB="10%"; fi
        if [ -z "$TEST_WAS_SET" ]; then TEST="0"; fi
        if [ -z "$TEST_MODE_WAS_SET" ]; then TEST_MODE="llffhold"; fi
        if [ -z "$ADD_K_WAS_SET" ]; then ADD_K="1"; fi
        if [ -z "$MIN_INDEX_GAP_WAS_SET" ]; then MIN_INDEX_GAP="4"; fi
        if [ -z "$ROUNDS_WAS_SET" ]; then ROUNDS="8"; fi
        if [ -z "$ITERS_MODE_WAS_SET" ]; then ITERS_MODE="popgs"; fi
        if [ -z "$FINAL_ITERS_WAS_SET" ]; then FINAL_ITERS="10000"; fi
        ;;
    popgs20)
        if [ -z "$INIT_TRAIN_WAS_SET" ]; then INIT_TRAIN="4"; fi
        if [ -z "$INIT_METHOD_WAS_SET" ]; then INIT_METHOD="random_fps"; fi
        if [ -z "$CALIB_WAS_SET" ]; then CALIB="10%"; fi
        if [ -z "$TEST_WAS_SET" ]; then TEST="0"; fi
        if [ -z "$TEST_MODE_WAS_SET" ]; then TEST_MODE="llffhold"; fi
        if [ -z "$ADD_K_WAS_SET" ]; then ADD_K="1"; fi
        if [ -z "$MIN_INDEX_GAP_WAS_SET" ]; then MIN_INDEX_GAP="4"; fi
        if [ -z "$ROUNDS_WAS_SET" ]; then ROUNDS="16"; fi
        if [ -z "$ITERS_MODE_WAS_SET" ]; then ITERS_MODE="popgs"; fi
        if [ -z "$FINAL_ITERS_WAS_SET" ]; then FINAL_ITERS="21000"; fi
        ;;
    "")
        ;;
    *)
        echo "ERROR: unknown PRESET=$PRESET"
        exit 1
        ;;
esac
TARGET_COVERAGE="$(python -c "print(1.0 - float('${ALPHA}'))")"
OUTPUT_BASE="${OUTPUT_BASE:-/scratch-shared/$USER/output_fullwidth}"
AL_ROOT="${AL_ROOT:-$OUTPUT_BASE/active_learning/$(basename "$SCENE")}"
RUN_ROOT="$AL_ROOT/$METHOD/seed_${SEED}"
NEED_COLOR=0
NEED_SENSITIVITY=0
NEED_VISIBILITY=0
case "$METHOD" in
    random|uniform)
        ;;
    conformal_color|raw_color|color)
        NEED_COLOR=1
        ;;
    conformal_visibility|raw_visibility|visibility)
        NEED_VISIBILITY=1
        ;;
    conformal_sensitivity|raw_sensitivity|sensitivity|fisher|pup)
        NEED_SENSITIVITY=1
        ;;
    conformal_combined|raw_combined|combined)
        NEED_COLOR=1
        NEED_SENSITIVITY=1
        NEED_VISIBILITY=1
        ;;
    *)
        echo "ERROR: unknown METHOD=$METHOD"
        exit 1
        ;;
esac

module purge
module load 2025
module load Anaconda3/2025.06-1

module load CUDA/12.9.1
export CUDA_HOME=$CUDA_ROOT
export TORCH_CUDA_ARCH_LIST="8.0"

cd $HOME/conformal-uncertainty-3dgs

# Properly initialize conda for non-interactive bash
# Temporarily disable 'set -u' to avoid unbound variable errors in conda activation
set +u
eval "$(conda shell.bash hook)"
conda activate gaussian_splatting
set -u

mkdir -p "$RUN_ROOT" outfiles

echo "================================================================"
echo "Active learning loop"
echo "Scene      : $SCENE"
echo "Root       : $RUN_ROOT"
echo "Method     : $METHOD"
echo "Seed       : $SEED"
echo "Rounds     : $ROUNDS"
echo "Preset     : ${PRESET:-none}"
echo "Init train : $INIT_TRAIN"
echo "Init method: $INIT_METHOD"
echo "Calib/Test : $CALIB / $TEST"
echo "Test mode  : $TEST_MODE"
echo "Add K      : $ADD_K"
echo "Index gap  : $MIN_INDEX_GAP"
echo "Idx penalty: $INDEX_PENALTY"
echo "Iterations : $ITERS"
echo "Iter mode  : $ITERS_MODE final=${FINAL_ITERS:-none}"
echo "Alpha      : $ALPHA"
echo "Signals    : color=$NEED_COLOR sensitivity=$NEED_SENSITIVITY visibility=$NEED_VISIBILITY"
echo "Start      : $(date)"
echo "================================================================"

# Skip pip install for submodules - they're pre-installed in the conda environment
# If needed, they can be reinstalled with: pip install --no-build-isolation submodules/NAME

# if ! python -c "import diff_gaussian_rasterization, simple_knn, fused_ssim" 2>/dev/null; then
#     echo "[setup] Building submodules ..."
#     pip install --no-build-isolation submodules/diff-gaussian-rasterization
#     pip install --no-build-isolation submodules/simple-knn
#     pip install --no-build-isolation submodules/fused-ssim
# fi

ROUND0_SPLITS="$RUN_ROOT/round_00/splits"
if [ ! -f "$ROUND0_SPLITS/train.txt" ]; then
    echo "[init] Creating initial active-learning split"
    python scripts/active_learning/splits.py init \
        --source_path "$SCENE" \
        --images images \
        --output_dir "$ROUND0_SPLITS" \
        --seed "$SEED" \
        --init_train "$INIT_TRAIN" \
        --init_method "$INIT_METHOD" \
        --calib "$CALIB" \
        --test "$TEST" \
        --test_mode "$TEST_MODE" \
        --llffhold "$LLFFHOLD"
fi

for ROUND in $(seq 0 "$ROUNDS"); do
    ROUND_PAD="$(printf "%02d" "$ROUND")"
    ROUND_OUT="$RUN_ROOT/round_${ROUND_PAD}"
    SPLIT_DIR="$ROUND_OUT/splits"
    OUTPUT_ROOT="$(dirname "$ROUND_OUT")"

    echo "================================================================"
    echo "[round $ROUND_PAD] output=$ROUND_OUT split=$SPLIT_DIR"
    echo "================================================================"

    echo "[round $ROUND_PAD] Training"
    TRAIN_VIEWS="$(grep -cve '^[[:space:]]*$' "$SPLIT_DIR/train.txt")"
    ROUND_ITERS="$ITERS"
    if [ "$ITERS_MODE" = "popgs" ]; then
        ROUND_ITERS=$((100 * TRAIN_VIEWS))
        if [ "$ROUND" -eq "$ROUNDS" ] && [ -n "$FINAL_ITERS" ]; then
            ROUND_ITERS="$FINAL_ITERS"
        fi
    fi
    echo "[round $ROUND_PAD] Training views=$TRAIN_VIEWS iterations=$ROUND_ITERS"
    python train.py -s "$SCENE" -m "$ROUND_OUT" --split_dir "$SPLIT_DIR" --iterations "$ROUND_ITERS" --eval

    if [ "$NEED_COLOR" -eq 0 ] && [ "$NEED_SENSITIVITY" -eq 0 ] && [ "$NEED_VISIBILITY" -eq 0 ]; then
        echo "[round $ROUND_PAD] Rendering RGB for evaluation/candidates"
        python render.py -m "$ROUND_OUT" --split_dir "$SPLIT_DIR" --skip_train
    fi

    if [ "$NEED_COLOR" -eq 1 ]; then
        echo "[round $ROUND_PAD] Rendering color"
        python scripts/render_color.py -m "$ROUND_OUT" --split_dir "$SPLIT_DIR" --output_root "$OUTPUT_ROOT" --skip_train
    fi

    if [ "$NEED_SENSITIVITY" -eq 1 ]; then
        echo "[round $ROUND_PAD] Fisher/PUP-style sensitivity"
        python scripts/compute_sensitivity.py -m "$ROUND_OUT"
        python scripts/render_per_gaussian_scalar.py \
            -m "$ROUND_OUT" --split_dir "$SPLIT_DIR" --output_root "$OUTPUT_ROOT" --skip_train \
            --modality sensitivity \
            --scores_path "$ROUND_OUT/uncertainty/fishers.npz" \
            --score_key fishers_log_dets \
            --score_transform shift_positive
    fi

    if [ "$NEED_VISIBILITY" -eq 1 ]; then
        echo "[round $ROUND_PAD] Visibility"
        python scripts/compute_visibility.py -m "$ROUND_OUT"
        python scripts/render_per_gaussian_scalar.py \
            -m "$ROUND_OUT" --split_dir "$SPLIT_DIR" --output_root "$OUTPUT_ROOT" --skip_train \
            --modality visibility \
            --scores_path "$ROUND_OUT/uncertainty/visibility.npz" \
            --score_key uncertainty_log
    fi

    echo "[round $ROUND_PAD] Conformal metrics"
    if [ "$NEED_COLOR" -eq 1 ]; then
        python scripts/conformal_prediction.py \
            --run_dir "$ROUND_OUT" \
            --modality color \
            --sigma_norm minmax_calib \
            --alpha "$ALPHA" \
            --calib_sample_ratio 0.1
    fi
    if [ "$NEED_SENSITIVITY" -eq 1 ]; then
        python scripts/conformal_prediction.py \
            --run_dir "$ROUND_OUT" \
            --modality sensitivity \
            --sigma_norm minmax_calib \
            --alpha "$ALPHA" \
            --calib_sample_ratio 0.1
    fi
    if [ "$NEED_VISIBILITY" -eq 1 ]; then
        python scripts/conformal_prediction.py \
            --run_dir "$ROUND_OUT" \
            --modality visibility \
            --sigma_norm minmax_calib \
            --alpha "$ALPHA" \
            --calib_sample_ratio 0.1
    fi

    echo "[round $ROUND_PAD] Image metrics"
    python metrics.py -m "$ROUND_OUT"

    if [ "$NEED_COLOR" -eq 1 ] || [ "$NEED_SENSITIVITY" -eq 1 ] || [ "$NEED_VISIBILITY" -eq 1 ]; then
        echo "[round $ROUND_PAD] Aggregation"
        python scripts/aggregate_results.py --run_dir "$ROUND_OUT"
    else
        echo "[round $ROUND_PAD] Skipping conformal aggregation; method has no uncertainty signal"
    fi

    if [ "$NEED_COLOR" -eq 1 ] || [ "$NEED_SENSITIVITY" -eq 1 ] || [ "$NEED_VISIBILITY" -eq 1 ]; then
        echo "[round $ROUND_PAD] Candidate rankings"
        python scripts/active_learning/export_rankings.py \
            --run_dir "$ROUND_OUT" \
            --splits candidate \
            --alpha "$ALPHA" \
            --sigma_norm minmax_calib \
            --score_top_fraction 0.10 \
            --seed "$SEED" \
            --acquisition_mode both \
            $( [ "$NEED_COLOR" -eq 1 ] || printf '%s' '--skip_color ' ) \
            $( [ "$NEED_SENSITIVITY" -eq 1 ] || printf '%s' '--skip_sensitivity ' ) \
            $( [ "$NEED_VISIBILITY" -eq 1 ] || printf '%s' '--skip_visibility ' )
    else
        echo "[round $ROUND_PAD] Skipping candidate rankings; method=$METHOD selects without scores"
    fi

    if [ "$ROUND" -lt "$ROUNDS" ]; then
        NEXT_ROUND=$((ROUND + 1))
        NEXT_PAD="$(printf "%02d" "$NEXT_ROUND")"
        NEXT_SPLITS="$RUN_ROOT/round_${NEXT_PAD}/splits"
        RANKINGS="$ROUND_OUT/active_learning/ours_${ROUND_ITERS}/view_rankings.json"

        echo "[round $ROUND_PAD] Selecting next $ADD_K views for round_$NEXT_PAD"
        if [ "$METHOD" = "random" ] || [ "$METHOD" = "uniform" ]; then
            python scripts/active_learning/splits.py update \
                --input_dir "$SPLIT_DIR" \
                --output_dir "$NEXT_SPLITS" \
                --method "$METHOD" \
                --add_k "$ADD_K" \
                --min_index_gap "$MIN_INDEX_GAP" \
                --index_penalty "$INDEX_PENALTY" \
                --round "$ROUND" \
                --seed "$SEED"
        else
            python scripts/active_learning/splits.py update \
                --input_dir "$SPLIT_DIR" \
                --output_dir "$NEXT_SPLITS" \
                --method "$METHOD" \
                --rankings_path "$RANKINGS" \
                --add_k "$ADD_K" \
                --min_index_gap "$MIN_INDEX_GAP" \
                --index_penalty "$INDEX_PENALTY" \
                --round "$ROUND" \
                --seed "$SEED"
        fi
    fi
done

echo "[done] Aggregating active-learning root"
python scripts/active_learning/aggregate.py --al_root "$AL_ROOT"

echo "[done] Plotting active-learning curves"
python scripts/active_learning/plot.py --al_root "$AL_ROOT" --coverage_target "$TARGET_COVERAGE"

echo "================================================================"
echo "Active-learning loop complete: $RUN_ROOT"
echo "End: $(date)"
echo "================================================================"
